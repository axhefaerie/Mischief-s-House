// room script file

function region1_WalksOnto()
{if(player.HasInventory(icuchillo)&&cuadroabierto==false){
        cKaty.Say("Tengo que ver si los simbolos sirven para algo... los tengo que cortar con el cuchillo");

  }else{
cKaty.ChangeRoom(18,78, 565, eDirectionRight);
if(senoravista){
csenora.ChangeRoom(18, 25, 530, eDirectionRight);}
}}

function region2_WalksOnto(){
  if(tieneMezcla==true){
  cKaty.ChangeRoom(11,1504,828, eDirectionLeft);}else{
    if(senoravista==true){
      csenora.Say("A donde te crees que vas, por ahi esta la puerta y tu no puedes salir de esta casa... No lo permitire");
      }else{
      cKaty.Say("Primero tengo que conseguir la mezcla, la necesito para salir de aqui, o eso decia la nota de la habitacion de lo señores");
      }
    }
}

function hHotspot1_Interact(Hotspot *theHotspot, CursorMode mode)
{
cKaty.Walk(715, 388, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionUp);
cKaty.ChangeRoom(20, 0, 0);
cDial.ChangeRoom(20, 776, 872);

}
function hHotspot2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  cKaty.Walk(901, 378, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionUp);
if(cuadroabierto==false){
cKaty.ChangeRoom(23, 0, 0);
cuadro4=true;
cDial.ChangeRoom(23, 776, 872);
}else{
  cKaty.ChangeRoom(24, 0, 0);
  cDial.ChangeRoom(24, 776, 872);
  }
}

