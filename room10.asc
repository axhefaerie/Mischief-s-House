function hHotspot5_Interact()
{
  cKaty.Walk(440, 709, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionUp);
  if(player.HasInventory(icuchillo)){
      cKaty.Say("Ya no hay nada más en el cofre que me sirva");

    }else{
if(cuch==true){
  cKaty.Say("¡¡Un cuchillo!!");
  cKaty.Say("¡Justo lo que necesitaba! No me lo creo");
  ccofresincuchillo.ChangeRoom(10, 429, 581);
  player.AddInventory(icuchillo);
  }else{
      cKaty.Say("Cuantas cosas hay en este cofre");

    }
}
}
function hHotspot5_Look()
{   
if(player.HasInventory(icuchillo)){
        cKaty.Say("Ya no hay nada más ahi que me sirva");
  }else{
cKaty.Say("¿Que habra en ese cofre?");
cKaty.Walk(440, 709, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionUp);}
}


function room_RepExec()
{
if(senoravista==false&&dialogosenora==true&&cuadroabierto==true){
cKaty.Walk(870, 675, eBlock, eWalkableAreas);
cKaty.Say("Ya tengo la cola de lagarto, solo me falta un ingrediente, me queda poco para salir de esta casa");
  csenora.ChangeRoom(10, 0, 840);
  csenora.Walk(420, 836, eBlock, eWalkableAreas);
  csenora.Say("¡¡¡¡LA CHICA!!!! No dejare que te escapes esta vez");
  cKaty.FaceCharacter(csenora);
  cKaty.Say("Nooooo, la señora me ha encontrado, ¿Que puedo hacer ahora?");
  csenora.Walk(player.x-55, player.y-55, eBlock, eWalkableAreas);
  csenora.FaceCharacter(cKaty);
  cKaty.FaceCharacter(csenora);
  csenora.Say("¡¡QUEEEE!!, NO PUEDE SER");
   csenora.Say("¡Ya te ha salido un cuerno, no te puedo atar, tienes demasiada fuerza... romperias las cuerdas");
  csenora.Say("No te podre encerrar en ningun sitio pero que sepas que no te voy a quitar el ojo de encima");
cKaty.Say("*No puede ser, me va a estar mirando todo el tiempo, tengo que conseguir que me deje de perseguir, necesito ayuda*");
    senoravista=true;
    dialogosenora=false;
  }
  if(senoravista==true){
     if (player.Room == csenora.Room) {
        if (csenora.Moving == false) {
            csenora.Walk(player.x+55, player.y-55, eBlock, eWalkableAreas);
        }
    }
    }
}
