// room script file
bool libroHechizos = false;
bool puertaAbierta = false;
function region1_WalksOnto()
{
cKaty.ChangeRoom(10, 1512, 822, eDirectionLeft);
}

function hHotspot1_Look()
{
  cKaty.Say("Ese libro parece un libro de hechizos o de pactos satanicos... nunca deberia haber venido a esta casa...");
cKaty.Say("Seguro que ahi pone lo que tengo que hacer para salir ");
cKaty.Walk(806, 890, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionUp);
}

function hHotspot1_Interact()
{
cKaty.Walk(806, 890, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionUp);
cKaty.Say("Según esto la mezcla hay que echarla en el símbolo del suelo");
libroHechizos=true;
}


function hHotspot3_Look(Hotspot *theHotspot, CursorMode mode)
{
if(libroHechizos==false){
    cKaty.Say("¿Y ese simbolo en el suelo? Voy a acercarme a ver que es");
  cKaty.Walk(806, 584, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionDown);
  }else{
    cKaty.Say("Ahi es donde tengo que echar la mezcla");
  cKaty.Walk(806, 584, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionDown);
    }
}

function hHotspot3_Interact(Hotspot *theHotspot, CursorMode mode)
{
if(libroHechizos==false){
  cKaty.Walk(806,584, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionDown);
    cKaty.Say("¿¿Para que sevira este simbolo??");

  }else{
     cKaty.Walk(806,584, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionDown);
    cKaty.Say("Tengo que echar la mezcla");
    }

}

function hHotspot3_UseInv(Hotspot *theHotspot, CursorMode mode)
{
    if(player.ActiveInventory.ID==4){
      cKaty.Walk(806,584, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionDown);
    cKaty.Say("¡Halaaaa! esporas magicas como la de las setas");
        cKaty.Say("La puerta esta haciendo ruidos... creo que esta funcionando");
        cKaty.FaceDirection(eDirectionUp);
        puertaAbierta=true;


      }

}

function hHotspot2_Interact(Hotspot *theHotspot, CursorMode mode)
{
if(puertaAbierta==false){
  cKaty.Walk(799, 488, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionUp);
  cKaty.Say("Tengo que averiguar donde tengo que usar la mezcla para poder salir");
  }else{
      cKaty.Walk(799, 488, eBlock, eWalkableAreas);
    cKaty.FaceDirection(eDirectionUp);
  cKaty.Say("Creo que ya esta abierta... ¡¡YA PUEDO SALIR!!");
    }
}

function region2_WalksOnto(Region *theRegion)
{if(puertaAbierta==false){
    cKaty.Say("Esta cerrada");
}else{
  cKaty.Say("Ya puedo salir de esta malidita casa");
  cgatovivo1.ChangeRoom(11, 1082, 414);
  cgatovivo1.Say("Te vas así, sin más, sin despedirte… Y yo pensando que habíamos forjado una amistad…");
  cKaty.FaceCharacter(cgatovivo1, eBlock);
  cKaty.Say("Que susto, como has aparecido asi de repente... Pero bueno Es verdad, perdón. Me has ayudado bastante hoy. Nunca lo olvidaré");
 cgatovivo1.Say("¡Qué bonitas palabras! Muy bien, ya te puedes ir");
 cKaty.Say(" ¿Y tú no te despides de mí?");
 cgatovivo1.Say("Que yo sepa, que lo sé todo, tú no me has ayudado en nada a mí, no hay nada que agradecer y por ello tampoco tengo por qué despedirme");
 cKaty.Say("Vale, sí, lo que tu digas");
 cKaty.Say("*Menos mal que me voy ya porque no podría aguantar más…*");
 cKaty.Say("¡Por fin, me voy!");
 cgatovivo1.Say("Hasta pronto, Katy… ");
 cKaty.FaceDirection(eDirectionUp);
 cKaty.ChangeRoom(25, 0, 0);
}
}
