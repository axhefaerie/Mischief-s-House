// room script file

function room_FirstLoad()
{

cDial.Say("¿Qué es esto? ¿Dónde estoy?");
cDial.Say("*Katy forcejea para tratar de soltarse, pero lo hace sin éxito*");
cDial.Say("Pensé que todo lo anterior había sido un sueño… Ojalá hubiese sido un sueño y me hubiera despertado en mi cama… Pero.. ¿C-cómo he llegado aquí?¿Quién ha hecho esto?");
cDial.Say("… ¿Hola? ");
cDial.Say("Será mejor que me desate antes de que venga alguien… si es que hay alguien por aquí.");
cDial.Say("*Katy comienza a forcejear más fuerte que antes, y de repente la cuerda se desata de una forma brusca*");
cKaty.ChangeRoom(14, 650, 550, eDirectionDown);
}



function room_Load()
{
gGui2.Visible=false;
gGui1.Visible=false;
}
