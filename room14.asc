// room script file
bool puedeSalir = false;
bool interaccionAndras =false;
bool guitarra = false;
bool caja=false;

function region1_WalksOnto()
{if(puedeSalir==true){

cKaty.ChangeRoom(4, 439, 625, eDirectionDown);
if(senoravista){
csenora.ChangeRoom(4, 439, 625, eDirectionDown);}
}
else{
  cKaty.Say("Parece que no se abre… Por supuesto que me iban a encerrar aquí. Tendrá que haber algo por aquí con lo que pueda abrir esta puerta.");
  cKaty.Say("Voy a mirar por la habitación a ver si encuentro algo para abrir la puerta");
  
}
}

function room_Load()
{  
gGui1.Visible=true;

}
function room_FirstLoad()
{
cKaty.Say("¡¿Eh?! Me acabo de desatar… ¡¿He roto la cuerda?! ¡¿Cómo es posible?! No sé qué está pasando… Todo esto es muy raro… Pero quiero salir de esta habitación cuanto antes… ¡y de esta casa!");
}






function hHotspot1_Interact()
{if(caja==false){
  cKaty.Walk(1132, 728, eBlock, eWalkableAreas);
 cKaty.Say("¡¡Oh!! Una palanca, la guardaré por si la necesito");
   player.AddInventory(ipalanca);
   caja=true;
}
}

function hHotspot1_Look()
{
cKaty.Say("¡¡Una caja!! Voy a acercarme a mirar que hay dentro");
cKaty.Walk(1132, 728, eBlock, eWalkableAreas);

}

function hHotspot2_UseInv()
{
cKaty.Walk(598, 290, eBlock, eWalkableAreas);
  if (player.HasInventory(illavehab)) {
             cKaty.Say("Ya esta abierta"); 
             puedeSalir=true;
   player.LoseInventory(illavehab);
        } else {
            
            cKaty.Say("Esto no me sirve aqui");
        }
 
  }


function hHotspot3_Look()
{
  cKaty.Walk(836, 586,  eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
cKaty.Say("En esa cama estaba ese señor... decian que tenia un demonio dentro... ¿Donde estará?");

}

function hHotspot4_Look()
{
cKaty.Say("Un reloj, a ver si funciona y puedo ver cuanto tiempo he estado incosciente");
cKaty.Walk(1076, 394,  eBlock, eWalkableAreas);
cKaty.Say("Pone que son las doce y media de la noche... obviamente no funciona ");

}

function hHotspot5_Look()
{

cKaty.Walk(1168, 412,  eBlock, eWalkableAreas);
cKaty.Say("La ventanas estan cerradas y en la calle no hay nadie... No puedo pedir ayuda");

}




function room_RepExec()
{
if(HasPlayerBeenInRoom(18)&&interaccionAndras==false){
  cAndras1.ChangeRoom(14, 1203, 522);
  interaccionAndras=true;
  cAndras1.Say("Grrr… Veeteee…");
  
}
if(senoravista==true){
     if (player.Room == csenora.Room) {
        if (csenora.Moving == false) {
            csenora.Walk(player.x+55, player.y-55, eBlock, eWalkableAreas);
        }

}
}
}
function hHotspot6_UseInv()
{if(player.ActiveInventory.ID==3){
  cKaty.Walk(872, 512, eBlock, eWalkableAreas);
  cKaty.FaceCharacter(cAndras1);
cAndras1.Say("Uuuh… Música… Agradable…");
cAndras1.Say("Hacia tiempo que no me sentia tan humano, lo que me hicieron mis hermanos... ahora lo recuerdo");
cAndras1.Say("¿¿Anda y tu quien eres??");
cKaty.Say("Me llamo Katy, estoy atrapada en esta casa y estoy intentando escapar");
cKaty.Say("*Andras me recuerda a alguien... pero no se a quien...*");
cKaty.Say("¿¿Tu sabes alguna salida secreta o algun lugar por donde pueda escapar??");
cAndras1.Say("LLevo 60 años en esta casa, no se como salir, pero si necesitas ayuda para algo aqui estoy");
    player.LoseInventory(iguitarra);
      cKaty.AddInventory(icuerno);
cKaty.Say("Genial, ya tengo el cuerno");
cKaty.Say("*Qué miedo he pasado al principio, pero al final Andras es una persona normal, atrapado aqui como yo... Bueno, ya he recuperado lo que necesitaba. Pero aún me faltan ingredientes para la mezcla, debería seguir buscando por la casa*");

}}


function room_AfterFadeIn()
{
if(senoravista==true){
  cKaty.Say("Hola Andras");
  csenora.Say("¿¿Andras??");
  csenora.Walk(1128, 534, eBlock, eWalkableAreas);
    csenora.Say("¿Qué haces aquí?");
      cKaty.Walk(657, 512, eBlock, eWalkableAreas);
    cAndras1.Say("TUUUUUU");
    cAndras1.Say("TU ME HICISTE ESTO");
    cAndras1.Say("Es momento de mi venganza");
    csenora.ChangeRoom(1, 0, 0);
    cKaty.Say("¡A-andras! ¡¿Qué has hecho?!");
    cAndras1.Say("No te preocupes Katy, ya no te molestara más");
    cAndras1.ChangeRoom(1, 0, 0);
    cKaty.Say("...");
       cKaty.Say("Me ha salvado… Ahora lo recuerdo… Ese… ese era el señor enfermo… el que tocó la campanilla… el que estaba atado en la cama…");
senoravista=false;
}
}
