// room script file
bool cocina =false;
bool andrasvisto =false;
function region1_WalksOnto()
{
  cKaty.ChangeRoom(9, 712, 868, eDirectionUp);
  if(senoravista){
csenora.ChangeRoom(9, 712, 868, eDirectionUp);}
  } 
    

function region2_WalksOnto()
{if(ingredientesEnBol&&tieneMezcla==false){
  cKaty.Say("Tengo que coger la mezcla");
  
  }else{
  if(tieneMezcla==true){
  cKaty.ChangeRoom(10, 1420, 450, eDirectionLeft); 
  }else
{if(player.HasInventory(icuerno)){
cKaty.ChangeRoom(10, 1420, 450, eDirectionLeft); 
if(senoravista){
csenora.ChangeRoom(10, 1380, 400, eDirectionLeft);}}else{
 if(andrasvisto==true){
      cKaty.Say("Necesito ese cuerno...");
      }else{
        cKaty.Say("No he visto todas las habitaciones...");}
      
    }
}}}
function region3_WalksOnto()
{
cKaty.ChangeRoom(8, 906, 125, eDirectionDown);
if(senoravista){
csenora.ChangeRoom(8, 906, 125, eDirectionDown);}
}

function region4_WalksOnto()
{
cKaty.ChangeRoom(6, 1070, 624, eDirectionUp);
if(senoravista){
csenora.ChangeRoom(6, 1070, 624, eDirectionUp);}
}

function room_FirstLoad()
{
  
  cKaty.Say("¡Lo he conseguido!");
  cgatovivo1.Say("¿Lo “HAS” conseguido? ¿Tú sola? Creo que alguien más merece algo de crédito…");
  cKaty.FaceCharacter(cgatovivo1);
  cKaty.Say("Me podrías haber dicho directamente lo que necesitaba. Me he tenido que recorrer prácticamente toda la casa por tu falta de claridad");
  cgatovivo1.Say("¿Entonces qué gracia tendría? Has vivido una gran aventura gracias a mi");
  cKaty.Say("Mhm… Supongo que tienes razón");
cKaty.Say("*Darle la razón es una buena idea, por si acaso necesito su ayuda más adelante*");
  cgatovivo1.Say("Te digo una cosa, siempre tengo razón, tenlo en cuenta chica");
cKaty.Say("*Bueno, a ver que protegian estas setas misteriosas");
cocina=true;
cKaty.Walk(730, 820, eBlock, eWalkableAreas);
cKaty.ChangeRoom(8, 906, 125, eDirectionDown);
}

function room_RepExec()
{
  if(senoravista==true){
     if (player.Room == csenora.Room) {
        if (csenora.Moving == false) {
            csenora.Walk(player.x+55, player.y-55, eBlock, eWalkableAreas);
        }
    }
    }
if(andrasvisto==false&&cocina==true){
  cKaty.Say("Que me esta pasando ... ");
  cKaty.Walk(744, 628, eBlock, eWalkableAreas);
  cAndras1.ChangeRoom(18,654, 604);
  cKaty.FaceDirection(eDirectionLeft, eBlock);
  cKaty.Say("¡¡¡¡AHHHHH QUIEN O QUE ERES!!!!");
  cAndras1.Say("AjbJ*huAkjb$uHBLbkjbb/wejf");
  cAndras1.ChangeRoom(14, 1203, 522);
  andrasvisto=true;
  player.LoseInventory(icuerno);
  cKaty.Say("¡¡¿Queeé?!! Me ha quitado el cuerno… ¿¡Qué está pasando!?");
cgatovivo1.Say("Probablemente has enfadado a Andras con esos cuernos tuyos");
cKaty.FaceCharacter(cgatovivo1);
cgatovivo1.Say("Estará celoso de que ya no es el único demonio de la casa. Sin mencionar que los tuyos son bastante más bonitos…");
  cKaty.Say("¿Andras?… Ese es Andras… Necesito ese cuerno para poder salir, y tengo mucho miedo");
  cgatovivo1.Say("No tienes por qué tener miedo de Andras, es verdad que es un demonio despiadado que ha atormentado a más de una persona e incluso se ha comido a alguna que recuerde…");
  cKaty.Say("¡Eso no me está ayudando a no tenerle miedo! Más bien lo contrario…");
  cgatovivo1.Say("No me has dejado acabar, chica estúpida. Puedes lograr caerle bien a Andras. ¿Sabes que le encanta la música?");
  cKaty.Say(" Y eso a mí de qué me sirve");
  cgatovivo1.Say("¿No sabes cómo hacer música? Los señores de la casa son aficionados a ella, seguro que tienen un instrumento en alguna parte que te pueda servir");
   cKaty.Say("Los señores de la casa… Oye ¿sabes algo de los señores?");
   cgatovivo1.Say("¿Que si sé algo de ellos? Vivo en su casa, ¿tú qué crees, chica?");
   cKaty.Say("Solo dime qué se supone que hacen en esta casa. Me han secuestrado, ¡me quieren hacer algo!");
   cgatovivo1.Say("Oh sí, sobre eso… Resulta que los señores son muy… espirituales");
   cKaty.Say("¿Y eso qué tiene que ver conmigo?");
   cgatovivo1.Say("Pues bastantes cosas… Pero cosas que no tienen importancia");
   
  }
}
