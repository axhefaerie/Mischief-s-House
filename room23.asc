// room script file

function hHotspot5_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  cKaty.ChangeRoom(10, 901, 400);

}

function hHotspot1_UseInv(Hotspot *theHotspot, CursorMode mode)
{
if(player.ActiveInventory.ID==9){
  csimbolo2.ChangeView(13);
  csimbolo2.ChangeRoom(23, 762, 342);
  cKaty.LoseInventory(isimbolo2);
  csimbolo2.AddInventory(isimbolo2);
  
  }
}

function room_RepExec()
{
if(csimbolo1.HasInventory(isimbolo1)&&csimbolo2.HasInventory(isimbolo2)&&csimbolo3.HasInventory(isimbolo3)){
  cDial.Say("¿Que suena? Parecen engranajes");
  csimbolo1.LoseInventory(isimbolo1);
  Wait(4);
  cKaty.ChangeRoom(24, 0, 0);
  cuadroabierto=true;
  cDial.ChangeRoom(24, 776, 872);

}
}
function hHotspot2_UseInv(Hotspot *theHotspot, CursorMode mode)
{
if(player.ActiveInventory.ID==8){
  csimbolo1.ChangeView(12);
  csimbolo1.ChangeRoom(23, 858, 338);
    cKaty.LoseInventory(isimbolo1);
  csimbolo1.AddInventory(isimbolo1);
  
  }
}

function hHotspot3_UseInv(Hotspot *theHotspot, CursorMode mode)
{
if(player.ActiveInventory.ID==10){
  csimbolo3.ChangeView(14);
  csimbolo3.ChangeRoom(23, 951, 314);
    cKaty.LoseInventory(isimbolo3);
  csimbolo3.AddInventory(isimbolo3);
  
