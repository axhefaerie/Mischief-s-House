// room script file
bool entroHab=false;
function region1_WalksOnto()
{
cKaty.ChangeRoom(14, 593, 309, eDirectionDown);
if(senoravista==true){
csenora.ChangeRoom(14, 593, 309, eDirectionDown);}
}

function region2_WalksOnto()
{if(entroHab==false){
  cKaty.Say("¡¡SIIII!! Esta abierta, por fin me pasa algo bueno desde que empezo esta pesadilla"); 
  entroHab=true;
}
cKaty.ChangeRoom(5, 540, 842, eDirectionUp);
if(senoravista){
csenora.ChangeRoom(5, 540, 842, eDirectionUp);}
}

function region3_WalksOnto()
{
cKaty.ChangeRoom(6, 439, 625, eDirectionRight);
if(senoravista){
csenora.ChangeRoom(6, 439, 625, eDirectionRight);}
}


function room_FirstLoad()
{
cKaty.Say("Por fin he podido salir de esa habitación, ahora debo encontrar la forma de salir de esta maldita casa"); 
cKaty.Say("Debería mirar por las habitaciones y pasillos a ver si veo una salida o algo que me pueda ayudar");

}

