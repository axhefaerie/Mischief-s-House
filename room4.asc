bool gatoVisto =false;

function region4_WalksOnto()
{
  if(gatoVisto==false){
cKaty.Say("Pobre gatito… Está disecado, que tétrico.");
  gatoVisto=true;
  }
}



function room_RepExec()
{
if(senoravista==true){
     if (player.Room == csenora.Room) {
        if (csenora.Moving == false) {
            csenora.Walk(player.x+55, player.y-55, eBlock, eWalkableAreas);
        }
    }
    }
}

function room_AfterFadeIn()
{
  if(player.HasInventory(icolalagarto)&&player.HasInventory(icuerno)&&senoravista==false){
    if(player.HasInventory(iflor)){
      }else{
    cKaty.Say("Ya me he conseguido librar de la señora, menos mal");
    
    }
}}

function room_Load()
{
if(entroHab==true){
  cGatodisecado1.ChangeRoom(1);
  }
}
