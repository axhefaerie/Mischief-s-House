function hHotspot1_UseInv(Hotspot *theHotspot, CursorMode mode)
{
if (player.ActiveInventory.ID == 4){
  cKaty.Walk(726, 426, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionRight);
    cKaty.Say("Ya tengo la sal, ahora hay que probar a ver si le hace algun efecto a las setas");
    tarroconSal = true;

  }
}
