  cKaty.FaceDirection(eDirectionDown);
  

}

function hHotspot1_Interact()
{
  Intersal=true;
if(HasPlayerBeenInRoom(9)){
  if(player.HasInventory(itarro)){
     cKaty.Walk(726, 426);
  cKaty.FaceDirection(eDirectionRight);
    cKaty.Say("Ahora tengo que usar el tarro");
    }else{
  cKaty.Walk(726, 426);
  cKaty.FaceDirection(eDirectionRight);
    cKaty.Say("Necesito algo para coger la sal");
}}else{
   cKaty.Walk(726, 426);
  cKaty.FaceDirection(eDirectionRight);
       cKaty.Say("Esta familia es muy extraña... ¿Para que tendran esta sal aqui? ");
       
}
}

function room_RepExec()
{
if(Interarma==true){
  if(Intersal==true){
      if(Interlibro==true){
        
  InterTodo=true;}}
  }
  if(senoravista==true){
     if (player.Room == csenora.Room) {
        if (csenora.Moving == false) {
            csenora.Walk(player.x+55, player.y-55, eBlock, eWalkableAreas);
        }
    }
    }
}

