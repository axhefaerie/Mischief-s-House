// room script file
bool InterTodo=false;
bool Interarma=false;
bool Intersal=false;
bool Interlibro=false;
bool SenoresHablan=false;

function region1_WalksOnto()
{if(InterTodo==true){
  if(SenoresHablan==true){
cKaty.ChangeRoom(4, 1110, 622, eDirectionLeft);
if(senoravista){
csenora.ChangeRoom(4, 1110, 622, eDirectionLeft);}
}
else{
      cKaty.Say("¿Que es eso? Oigo pasos, me tengo que esconder por si entran a la habitación");
      
      cKaty.Walk(1190, 612, eBlock, eWalkableAreas);
       cKaty.Walk(1198, 896, eBlock, eWalkableAreas);
       csenoradial.Say("SEÑORA: No me lo puedo creer, ¡La has dejado escapar!");
       csenordial.Say("SEÑOR: Yo no la he dejado escapar, admite que esto ha sido cosa de los dos.");
       csenoradial.Say("SEÑORA: Ahora esa chica anda suelta… no podemos dejar que escape. ");
       csenordial.Say("SEÑOR: Lo más seguro es que aún siga dentro de la casa.");
              csenoradial.Say("SEÑORA: No vamos a dejarla sola nunca, ¿me oyes? ¡Nunca! Al menos hasta que todo esto acabe, aún no ha terminado el proceso…");
cKaty.Walk(1190, 612, eBlock, eWalkableAreas);
       cKaty.Walk(788, 616, eBlock, eWalkableAreas);
         cKaty.FaceDirection(eDirectionDown);
               cKaty.Say("Tengo que salir de aquí cuanto antes");

      SenoresHablan=true;

  
  }}
else{
    cKaty.Say("No he inspeccionado suficiente la habitación...");
}

}

