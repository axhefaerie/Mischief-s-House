// room script file


function region1_WalksOnto()
{
cKaty.ChangeRoom(4, 1160, 628, eDirectionUp);
if(senoravista){
csenora.ChangeRoom(4, 1160, 628, eDirectionUp);}
}

function region2_WalksOnto()
{
if(HasPlayerBeenInRoom(5)){if(HasPlayerBeenInRoom(8)){
cKaty.ChangeRoom(18, 465, 429, eDirectionDown);
if(senoravista){
csenora.ChangeRoom(18, 465, 429, eDirectionDown);}
}
else{cKaty.ChangeRoom(7, 465, 429, eDirectionDown);
  }
}
else{
  cKaty.Say("Hay una habitacion que no he visto");
  cKaty.Say("Antes de bajar mejor compruebo a ver si hay algo que me pueda servir");
  }
}

function hHotspot2_Look()
{
cKaty.Say("Más cuadros tetricos... se ve que a los señores les gusta mucho este arte peculiar");
}



function hHotspot1_Look()
{
  if(senoravista==true){
 
      cKaty.Say("*Con la señora mirandome no creo que sea un buen momento*");
      }else{
  if(HasPlayerBeenInRoom(15)){
      cKaty.Walk(677, 602, eBlock, eWalkableAreas);
      cKaty.FaceDirection(eDirectionLeft);
  if(player.HasInventory(icuchillo)){
          cKaty.Say("¡¡Con el cuchillo ya puedo cortarla!!");
    }else{
      cKaty.Say("Pero necesito algo para cortarla ...");
    }
  }else{
      cKaty.Walk(677, 602, eBlock, eWalkableAreas);
            cKaty.FaceDirection(eDirectionLeft);
    cKaty.Say("Que flores más bonitas, al menos tienen buen gusto en flores");
    }

}}
function hHotspot1_Interact()
{ if(tieneflor==true){
  cKaty.Say("Ya la tengo");
  }else{
if(senoravista==true){
 cKaty.Walk(677, 602, eBlock, eWalkableAreas);
      cKaty.FaceDirection(eDirectionLeft);
      cKaty.Say("*Con la señora mirandome no creo que sea un buen momento*");
      }else{
        if(HasPlayerBeenInRoom(15)){
      cKaty.Walk(677, 602, eBlock, eWalkableAreas);
      cKaty.FaceDirection(eDirectionLeft);
  if(player.HasInventory(icuchillo)){
          cKaty.Say("¡¡Con el cuchillo ya puedo cortarla!!");
    }else{
      
      cKaty.Say("Pero necesito algo para cortarla ...");
    }
  }else{
      cKaty.Walk(677, 602, eBlock, eWalkableAreas);
            cKaty.FaceDirection(eDirectionLeft);
    cKaty.Say("No hay nada que me sirva aqui");
}}}
}
function room_RepExec()
{
if(senoravista==true){
     if (player.Room == csenora.Room) {
        if (csenora.Moving == false) {
            csenora.Walk(player.x+55, player.y-55, eBlock, eWalkableAreas);
        }
    }
    }
}

function hHotspot1_UseInv(Hotspot *theHotspot, CursorMode mode)
{
if(player.ActiveInventory.ID==7&&tieneflor==false){
  cKaty.Walk(677, 602, eBlock, eWalkableAreas);
      cKaty.FaceDirection(eDirectionLeft);
  player.AddInventory(iflor);
cKaty.Say("Perfecto, ya la tengo");
tieneflor=true;
  }
}
