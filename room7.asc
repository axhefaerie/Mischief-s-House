// room script file
bool Hablargato1=false;
function region1_WalksOnto()
{
cKaty.ChangeRoom(9, 712, 868, eDirectionUp);
}

function region2_WalksOnto()
{
  if(HasPlayerBeenInRoom(8)){
  cKaty.ChangeRoom(10, 1420, 450, eDirectionLeft);}else{
            cKaty.Say("No he visto todas las habitaciones...");}

    }



function region3_WalksOnto(){
  cKaty.ChangeRoom(8, 906, 125, eDirectionDown);

  }


function region4_WalksOnto()
{
cKaty.ChangeRoom(6, 1070, 624, eDirectionUp);
}

function region5_WalksOnto()
{
if(Hablargato1==false){
  cKaty.Walk(902, 634, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
  cKaty.Say("...");
  cgatovivo1.Say("¿Qué es lo que miras?");
  cKaty.Say("¡¿E-el gato me está hablando?!");
  cgatovivo1.Say("Cálmate un poco y deja de llorar, ¿quieres?");
   cKaty.Say("N-no estoy llorando… ");
  cgatovivo1.Say("Mmmm… No me digas");
  Wait(4);
  cKaty.Say("Oye… ¿Cómo es que estás hablando?¡¿Cómo es que estás vivo?! Hace un momento… arriba… ¡estabas disecado!");
  cgatovivo1.Say("¿Ah sí? Bueno, pues será porque estoy disecado");
  cKaty.Say("Entonces, ¿cómo es que te estás moviendo?");
  cgatovivo1.Say("Mmmm… ¿y por qué estoy hablando?");
  cKaty.Walk(6, 496);
  cKaty.FaceDirection(eDirectionLeft);
  cKaty.Say("*¿Qué está pasando aquí? Este sitio, todo este sitio es muy raro y tétrico. Y encima ahora aparece este gato que al parecer ha vuelto a la vida… ya lo que faltaba dentro de esta casa de los horrores*");
   cKaty.Say("*Además, ¡es un liante! Será mejor que de momento no le haga mucho caso… … Qué dolor de cabeza tengo… me estoy encontrando mal… quiero salir de aquí cuanto antes*");
  cgatovivo1.Say("¡Eh tú!");
cKaty.Walk(902, 634);
  cKaty.FaceCharacter(cgatovivo1);
  cKaty.Say("Uuuh… ¿si?");
  cgatovivo1.Say("Te estabas quedando en trance… Una cosita importante antes de que te vayas, ten cuidado con Andras. Está por ahí suelto");
  cKaty.Say("¿Andras?");
  cgatovivo1.Say("Si ¿Tienes problemas de oído o qué? Ten cuidado y todo irá bien.");
  Hablargato1=true;
  }
else{}
}

function region6_WalksOnto()
{if(Hablargato1==true){
  if(cKaty.HasInventory(itarro)){
      cKaty.Say("Segun el libro al usar la sal en las setas ya podria pasar...");

  }else{ if(Hablargato2==false){
  cKaty.Say("*¿Qué?¿Por qué no puedo pasar?*");
      cKaty.FaceCharacter(cgatovivo1);
    cgatovivo1.Say("Ooh, así que las setas bloquean la puerta. Parece que no puedes pasar hasta eliminar sus esporas magicas");
cKaty.Say("¿Eso qué significa? ¿Qué tengo que hacer?");
    cgatovivo1.Say("Mmmm… Parece que estás en problemas y que necesitas ayuda… ¡Para eso estoy yo aquí! Sería genial si hubiera un modo de deshacerse de ellas, ¿no crees?");
cKaty.Say("¿Qué sabes sobre esto?");
    cgatovivo1.Say("No sé… A lo mejor son sensibles a alguna sustancia… o a lo mejor no lo son y nunca podrás entrar, quién sabe");
cKaty.Say("No pierdo nada por hacerle caso e investigar la casa a ver si encuentro la substancia de la que habla. Aunque sea muy molesto, puede que este gato pueda ayudarme después de todo");
  cgatovivo1.Say("Solo recuerda… Andras…");
  Hablargato2=true;}}
}
}

function hHotspot1_UseInv()
{
  if (tarroconSal == true) {
        cKaty.Walk(738, 674, eBlock, eWalkableAreas);
        cKaty.FaceDirection(eDirectionDown);
        cKaty.Say("¡Halaaaaa! Las esporas se están evaporando, parece que sí está teniendo efecto");
        cKaty.ChangeRoom(18, 738, 674);
        cgatovivo1.ChangeRoom(18, 993, 724);
        setasMuertas=true;
    } else {
      cKaty.Walk(738, 674, eBlock, eWalkableAreas);
        cKaty.FaceDirection(eDirectionDown);
        cKaty.Say("El tarro está vacío");
    }
}


    function hHotspot1_Interact() {
     
    if (!Hablargato1) {
        
        cKaty.Walk(738, 634, eBlock, eWalkableAreas);
                cKaty.FaceDirection(eDirectionDown);
        cKaty.Walk(902, 634, eBlock, eWalkableAreas);
