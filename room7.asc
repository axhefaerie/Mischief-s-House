        cgatovivo1.Say("Solo recuerda… Andras…");
        Hablargato2 = true;
    } else {
        
        if (player.HasInventory(itarro)) {
            cKaty.Walk(738, 674, eBlock, eWalkableAreas);
            cKaty.FaceDirection(eDirectionDown);
            cKaty.Say("Tengo que echar la sal a las setas");
        } else {
            cKaty.Walk(738, 674, eBlock, eWalkableAreas);
            cKaty.FaceDirection(eDirectionDown);
            cKaty.Say("Tengo que descubrir cómo poder pasar");
        }
    }
}