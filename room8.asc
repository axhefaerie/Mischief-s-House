// room script file
bool postIt = false;
bool cuerno= false;
bool bolInter = false;
bool ingrPuestos = false;
bool todosingredientes = false;
function hHotspot1_Interact()
{
cKaty.Walk(676, 453, eBlock, eWalkableAreas);
cKaty.FaceDirection(eDirectionUp, eBlock);
cKaty.ChangeRoom(19, 0, 0);
postIt = true;
}

function room_RepExec()
{
  if(senoravista==true){
     if (player.Room == csenora.Room) {
        if (csenora.Moving == false) {
            csenora.Walk(player.x+55, player.y-55, eBlock, eWalkableAreas);
        }
    }
    }
if(postIt==true&&cuerno==false){
  cKaty.Say("... que me esta pasando ....");
  cKaty.Say("¡AAAAAAAAAAAAAAAAAAAHHH! ¿¿M-me han salido cuernos?? ¡¿Qué me está pasando?! ¿Y encima uno se ha caído? Pero qué hago yo con esto ahora… No entiendo nada");
  cKaty.Say("Pero tengo que hacer la mezcla para poder salir ya de aquí.");
  cKaty.AddInventory(icuerno);
  cuerno=true;
  }
  
  if(bolconingredientes==3&&ingrPuestos==false){
        cKaty.Say("¡Ya tengo la mezcla! ¡Ya puedo salir!");
        cKaty.Say("Ahora necesito algo para llevarla a la puerta... seguro que algo de lo que llevo encima me sirve");
      ingrPuestos=true;
      ingredientesEnBol=true;

    }
     if(player.HasInventory(icolalagarto)&&player.HasInventory(icuerno)&& player.HasInventory(iflor)&& todosingredientes==false){
       todosingredientes=true;
       }
}

function hHotspot4_Interact()
{
  if(tieneMezcla==true){
    cKaty.Walk(661, 585, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
  cKaty.Say("Ya tengo la mezcla, tengo que ir a la puerta para intentar salir");}else{
    if(ingredientesEnBol==true){
      cKaty.Walk(661, 585, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
    cKaty.Say("Tengo que coger la mezcla con algo ... ");
  }else{
    
  
  if(player.HasInventory(icolalagarto)&&player.HasInventory(icuerno)&&player.HasInventory(iflor)){
  cKaty.Walk(661, 585, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
  cKaty.Say("Este bol es perfecto para hacer la mezcla");
    cKaty.Say("Ahora tengo que meter los ingredientes aqui");

  }else{if(player.HasInventory(icolalagarto)|| player.HasInventory(icuerno)|| player.HasInventory(iflor)){
    cKaty.Walk(661, 585, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
    cKaty.Say("Este bol es perfecto para hacer la mezcla");
        cKaty.Say("Pero me faltan ingredientes");

    }
else{ if(cuerno==true){
  cKaty.Walk(661, 585, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
  cKaty.Say("Tengo que hacer la mezcla aqui pero me faltan los ingredientes, tengo que recuperar ese cuerno");
  }else{
cKaty.Walk(661, 585, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
cKaty.Say("Esta vacio, pero a lo mejor este bol me puede servir mas tarde...");}
}
}
bolInter=true;
}
}
bolInter = true;
}


function hHotspot4_Look()
{
if (tieneMezcla == true) {
    cKaty.Walk(661, 585, eBlock, eWalkableAreas);
    cKaty.FaceDirection(eDirectionDown);

    if (ingredientesEnBol == true) {
        cKaty.Say("Ya tengo la mezcla, tengo que ir a la puerta para intentar salir");
        cKaty.Walk(661, 585, eBlock, eWalkableAreas);
        cKaty.FaceDirection(eDirectionDown);
        cKaty.Say("Tengo que coger la mezcla con algo ...");
    } else {
        if (player.HasInventory(icolalagarto) && player.HasInventory(icuerno) && player.HasInventory(iflor)) {
            cKaty.Walk(661, 585, eBlock, eWalkableAreas);
            cKaty.FaceDirection(eDirectionDown);
            cKaty.Say("Este bol es perfecto para hacer la mezcla");
            cKaty.Say("Ahora tengo que meter los ingredientes aquí");
        } else if (player.HasInventory(icolalagarto) || player.HasInventory(icuerno) || player.HasInventory(iflor)) {
            cKaty.Walk(661, 585, eBlock, eWalkableAreas);
            cKaty.FaceDirection(eDirectionDown);
            cKaty.Say("Este bol es perfecto para hacer la mezcla");
            cKaty.Say("Pero me faltan ingredientes");
        } else {
            cKaty.Walk(661, 585, eBlock, eWalkableAreas);
            cKaty.FaceDirection(eDirectionDown);
            cKaty.Say("Un bol... ¿Tendrá algo dentro?");
        }
    }
}}

function hHotspot3_Interact()
{
  cKaty.Walk(486, 469, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionLeft, eBlock);
  cKaty.Say("Buaag. Qué asco, creo que voy a vomitar si sigo así de cerca de la sangre");
}

function region1_WalksOnto()
{if(postIt==true&&bolInter==true){
cKaty.ChangeRoom(18, 740, 688);
if(senoravista){
csenora.ChangeRoom(18, 740, 688);}
}else{
  cKaty.Say("No he investigado la habitacion lo suficiente");
  }
}
function hHotspot4_UseInv(Hotspot *theHotspot, CursorMode mode) {
  cKaty.Walk(661, 585, eBlock, eWalkableAreas);
  cKaty.FaceDirection(eDirectionDown);
  if(todosingredientes==true){
    if (player.ActiveInventory.ID == 5) {
        cKaty.LoseInventory(icuerno);
        cKaty.Say("Hala, el cuerno ya está");
        bolconingredientes++;
    } else if (player.ActiveInventory.ID == 11) {
        cKaty.LoseInventory(icolalagarto);
        cKaty.Say("Qué asco la cola del lagarto... pero ya está en el bol");
        bolconingredientes++;
    } else if (player.ActiveInventory.ID == 6) {
        cKaty.LoseInventory(iflor);
        cKaty.Say("Flor en el bol");
        bolconingredientes++;
    } else if (player.ActiveInventory.ID == 4 && bolconingredientes > 2) {
        cKaty.Say("Perfecto, con esto me puedo llevar la mezcla");
        cKaty.Say("Ya está, no me lo creo, por fin voy a poder salir");
        tieneMezcla = true;
    } else {
        cKaty.Say("Esto no me sirve aquí");
    }
}else{
  if (player.ActiveInventory.ID == 6||player.ActiveInventory.ID == 11||player.ActiveInventory.ID == 5){
  cKaty.Say("Tengo que tener todos los ingredientes antes de intentar hacer la mezcla");}else{
            cKaty.Say("Esto no me sirve aquí");

}}
}