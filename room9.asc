          cKaty.ChangeRoom(18, 934, 362, eDirectionDown);
          if(senoravista==true){
          csenora.ChangeRoom(18, 934, 362, eDirectionDown);}
       }else{
        cKaty.ChangeRoom(7, 934, 362, eDirectionDown);}
  }else{
   
    cEmo.Say("¿Ya te vas?");
  cKaty.Walk(364, 602, eBlock, eWalkableAreas);
cKaty.FaceCharacter(cEmo);
Wait(5);
cKaty.Say("Ehh… sí. No he podido encontrar tu marcapáginas… Lo siento mucho.");
cEmo.Say("No te preocupes por el marcapáginas. Me he dado cuenta de que lo he tenido encima todo este tiempo");
cKaty.Say("Me alegro que no se te haya perdido entonces… Bueno… Adiós.");
cEmo.Say("¡Hasta luego!"); 
  Hablaremo2=true;}
  
  }
}
}

 }



