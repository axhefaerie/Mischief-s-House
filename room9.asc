            marcapaginas=true;

        }
}}}

function room_AfterFadeIn()
{
if(Hablaremo1==false){
  cKaty.Say("¡¡Anda, Shell esta aqui!!");
cKaty.Walk(364, 602, eBlock, eWalkableAreas);
cKaty.FaceCharacter(cEmo);
cEmo.Say("Uy… Hola, ¿qué haces aquí?");
cKaty.Say("Hola… Perdón, no pretendía interrumpir. Quería leer unos libros. Pero, ¿qué haces tú aquí, Shell?");
cEmo.Say("Esperándote… Lo que significa que… ya todo ha terminado, ¿no?");
cKaty.Say("Emm… No sé… ¿Qué se supone que ha terminado?¿Es algo malo?");
cEmo.Say("No le des muchas vueltas, no hay nada de qué preocuparse. Simplemente que ya todo ha terminado y eso me alegra. Era algo que sí o sí tenía que pasar.");
cKaty.Say("...");
cEmo.Say("Mientras buscas los libros que querías leer, ¿me puedes ayudar a encontrar un marcapáginas que he perdido? No sé dónde lo dejé y es muy importante para mi…");
cKaty.Say("Sí, claro… Miraré a ver si lo encuentro");
Hablaremo1=true;
}else{}

}
